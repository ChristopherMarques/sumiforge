{
  "name": "SumiForge (@sumi-forge/react) · Pintura Viva e Caligrafia Japonesa em React",
  "short_name": "SumiForge",
  "description": "Biblioteca React para pintura animada de imagens, pincéis com pressão real e cenários procedurais japoneses.",
  "start_url": "/",
  "display": "standalone",
