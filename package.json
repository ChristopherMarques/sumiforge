{
  "name": "@sumi-forge/react",
  "version": "1.0.0",
  "description": "Japanese Sumi-e (ink wash painting) physics & generative canvas components for React",
  "author": "Christopher Marques Correa",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "sumi-e",
    "canvas",
    "brush",
    "roughjs",
    "ink-wash",
    "generative-art",
    "japanese-calligraphy",
    "vfx"
  ],
  "type": "module",
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    }
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristopherMarques/sumiforge.git"
  },
  "homepage": "https://sumiforge.vercel.app",
  "bugs": {
    "url": "https://github.com/ChristopherMarques/sumiforge/issues"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist dist-lib dist-app",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:lib": "rm -rf dist-lib && npm run build:types && vite build --config vite.config.lib.ts",
    "build:app": "vite build",
    "build": "npm run clean && npm run build:app && npm run build:lib",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
